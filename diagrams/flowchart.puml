@startuml perimeter_flowchart

|Калfндарь событий|
start
:Запланировать первое обнаружение\nдля каждой камеры;

repeat
  |Календарь событий|
  :Извлечь ближайшее событие\nи перевести модельное время;

  if (Тип события?) then (обнаружение от камеры)
    |Источник|
    :Сформировать событие обнаружения\n(камера, координаты, тип цели,\nуверенность, день/ночь) [ИБ];
    :Запланировать следующее обнаружение по\nэкспоненциальному интервалу,\nесли сформировано меньше N событий;
    |Статистика|
    :Учесть сформированное событие;
    |Диспетчер постановки|
    :Найти первую свободную ячейку\nс начала буфера;
    if (Свободная ячейка есть?) then (да)
      |Буфер|
      :Записать событие в найденную ячейку;
    else (нет)
      |Буфер|
      :Найти и извлечь событие с самым\nранним временем поступления;
      |Статистика|
      :Учесть отказ для извлечённого события;
      |Буфер|
      :Записать новое событие\nв освободившуюся ячейку;
    endif
  else (окончание анализа)
    |Аналитический модуль|
    :Завершить анализ и принять решение\n(нарушитель, ложное срабатывание, транспорт);
    :Освободить модуль;
    |Статистика|
    :Учесть обработанное событие\n(ожидание, обслуживание, пребывание);
  endif

  |Диспетчер выбора|
  while (Буфер не пуст\nи есть свободный модуль?) is (да)
    :Найти свободный модуль,\nначиная с модуля № 1 j;
    |Буфер|
    :Выбрать и извлечь событие с самым\nпоздним временем поступления;
    |Аналитический модуль|
    :Начать анализ события;
    :Определить время анализа\nравномерно на [a, b];
    |Календарь событий|
    :Запланировать окончание анализа;
    |Диспетчер выбора|
  endwhile (нет)

  |Отображение|
  :Показать календарь событий, буфер,\nсостояние модулей и статистику;

repeat while (Календарь не пуст?\n(идёт генерация или анализ)) is (да) not (нет)

|Статистика|
:Рассчитать итоговые показатели:\nотказы, времена, загрузка модулей;
|Отображение|
:Вывести сводную таблицу результатов;
stop

@enduml
